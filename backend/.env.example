# 在此文件中设置 Anthropic API Key
ANTHROPIC_API_KEY=your-api-key-here

# 自定义 API Base URL（可选，用于代理或私有部署）
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 模型名称（可选）
# MODEL_NAME=claude-sonnet-4-5-20250929

# Agent 最大工具调用轮次
# MAX_TURNS=10

# ─── Volcengine 多账号凭证引用示例 ───
# 真实 AK/SK 只放在本地 backend/.env；聊天和长期记忆中只使用 credential_ref
# credential_ref: peets_prod_main
# VOLC_CREDENTIAL_PEETS_PROD_MAIN_AK=your-volc-ak
# VOLC_CREDENTIAL_PEETS_PROD_MAIN_SK=your-volc-sk

# ─── SQLite 配置 ───
SQLITE_PATH=data/app.db

