# AgentWeave backend 配置示例
# 用法：
# 1. 复制本文件为 backend/.env
# 2. 默认值已经按当前项目代码填写；只有接入外部服务或启用登录时才需要额外修改

# ===== Claude / Agent 运行时 =====

# ANTHROPIC_API_KEY
# 含义：Anthropic API Key，供 Agent 对话调用模型。
# 本项目默认值：空字符串。
# 说明：为空时 `/api/health` 仍可返回 ok，但聊天能力不可用。
ANTHROPIC_API_KEY=

# ANTHROPIC_BASE_URL
# 含义：Anthropic API 的代理/网关地址。
# 本项目默认值：未设置。
# 说明：只有接入代理或兼容网关时才需要填写。
ANTHROPIC_BASE_URL=

# MODEL_NAME
# 含义：默认使用的模型名称。
# 本项目默认值：claude-sonnet-4-5-20250929
MODEL_NAME=claude-sonnet-4-5-20250929

# MAX_TURNS
# 含义：单次 Agent 运行允许的最大工具回合数。
# 本项目默认值：10
MAX_TURNS=10

# SQLITE_PATH
# 含义：SQLite 数据文件路径。
# 本项目默认值：data/app.db
# 说明：相对路径会按 backend/ 目录解析。
SQLITE_PATH=data/app.db


# ===== 日志 =====

# LOG_LEVEL
# 含义：日志级别。
# 本项目默认值：INFO
LOG_LEVEL=INFO

# LOG_FILE
# 含义：日志文件输出路径。
# 本项目默认值：backend/logs/app.log
# 说明：这里使用相对写法，等价于在 backend/ 下写入 logs/app.log。
LOG_FILE=logs/app.log

# LOG_MAX_SIZE_MB
# 含义：单个日志文件滚动切分大小，单位 MB。
# 本项目默认值：10
LOG_MAX_SIZE_MB=10

# LOG_BACKUP_COUNT
# 含义：日志滚动后保留的历史文件数量。
# 本项目默认值：5
LOG_BACKUP_COUNT=5


# ===== 登录认证 / OIDC / RBAC =====

# AUTH_ENABLED
# 含义：是否启用登录认证和 RBAC 权限控制。
# 本项目默认值：false
AUTH_ENABLED=false

# OIDC_ISSUER_URL
# 含义：OIDC 身份提供方的 issuer 地址。
# 本项目默认值：空字符串。
# 说明：Keycloak 常见写法是 https://<host>/realms/<realm>。
OIDC_ISSUER_URL=

# OIDC_CLIENT_ID
# 含义：OIDC 客户端 ID。
# 本项目默认值：空字符串。
OIDC_CLIENT_ID=

# OIDC_CLIENT_SECRET
# 含义：OIDC 客户端密钥。
# 本项目默认值：空字符串。
OIDC_CLIENT_SECRET=

# OIDC_REDIRECT_URI
# 含义：登录成功后 OIDC 回调到本项目后端的地址。
# 本项目默认值：空字符串。
# 本地开发常用值：http://127.0.0.1:8000/api/auth/callback
OIDC_REDIRECT_URI=

# OIDC_SCOPE
# 含义：登录时申请的 OIDC scope。
# 本项目默认值：openid profile email
OIDC_SCOPE=openid profile email

# OIDC_ROLE_CLAIM
# 含义：从 userinfo/claims 中读取外部角色的字段名。
# 本项目默认值：roles
# 说明：填写 roles 时，项目还会兼容 Keycloak 的 realm_access.roles 回退读取。
OIDC_ROLE_CLAIM=roles

# OIDC_ROLE_MAP
# 含义：把外部角色映射到本地角色 viewer / operator / admin。
# 本项目默认值：viewer=viewer,operator=operator,admin=admin
OIDC_ROLE_MAP=viewer=viewer,operator=operator,admin=admin

# AUTH_DEFAULT_ROLE
# 含义：当外部身份没有匹配到任何本地角色时使用的兜底角色。
# 本项目默认值：viewer
AUTH_DEFAULT_ROLE=viewer

# LOCAL_AUTH_ENABLED
# 含义：是否启用本地用户名/密码登录入口。
# 本项目默认值：false
LOCAL_AUTH_ENABLED=false

# LOCAL_ADMIN_USERNAME
# 含义：本地固定管理员账号用户名。
# 本项目默认值：空字符串。
LOCAL_ADMIN_USERNAME=

# LOCAL_ADMIN_PASSWORD
# 含义：本地固定管理员账号密码。
# 本项目默认值：空字符串。
# 说明：当前版本用于启动期本地管理员登录，生产环境应尽快改为更安全的密码存储方案。
LOCAL_ADMIN_PASSWORD=

# LOCAL_ADMIN_DISPLAY_NAME
# 含义：本地管理员在 UI 中显示的名称。
# 本项目默认值：Local Admin
LOCAL_ADMIN_DISPLAY_NAME=Local Admin


# ===== 会话 / Cookie / CORS =====

# SESSION_SECRET
# 含义：后端 SessionMiddleware 的签名密钥。
# 本项目默认值：agentweave-session-secret
# 说明：生产环境务必替换成随机强密钥。
SESSION_SECRET=agentweave-session-secret

# SESSION_COOKIE_NAME
# 含义：浏览器中的登录会话 Cookie 名称。
# 本项目默认值：agentweave_session
SESSION_COOKIE_NAME=agentweave_session

# SESSION_COOKIE_SAMESITE
# 含义：Cookie SameSite 策略。
# 本项目默认值：lax
SESSION_COOKIE_SAMESITE=lax

# SESSION_COOKIE_SECURE
# 含义：是否只在 HTTPS 下发送 Cookie。
# 本项目默认值：false
# 说明：部署到 HTTPS 时建议改为 true。
SESSION_COOKIE_SECURE=false

# CORS_ALLOW_ORIGINS
# 含义：允许携带 Cookie 访问后端的前端来源列表，使用逗号分隔。
# 本项目默认值：http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# ===== Skills 可选配置 =====

# MYSQL_CONNECT_TIMEOUT
# 含义：mysql-sql-analyzer Skill 连接 MySQL 的超时时间，单位秒。
# 本项目默认值：5
MYSQL_CONNECT_TIMEOUT=5

# MYSQL_USER
# 含义：mysql-sql-analyzer Skill 使用的 MySQL 用户名。
# 本项目默认值：空字符串。
MYSQL_USER=

# MYSQL_PASSWORD
# 含义：mysql-sql-analyzer Skill 使用的 MySQL 密码。
# 本项目默认值：空字符串。
MYSQL_PASSWORD=

# MYSQL_CHARSET
# 含义：mysql-sql-analyzer Skill 使用的字符集。
# 本项目默认值：utf8mb4
MYSQL_CHARSET=utf8mb4


# ===== 云凭证引用示例 =====

# VOLC_CREDENTIAL_<REF>_AK / VOLC_CREDENTIAL_<REF>_SK
# 含义：给 Volcengine 相关 Skill 按引用名注入 AK/SK。
# 本项目默认值：无固定默认值，按你的 credential_ref 自行定义变量名。
# 示例：当 credential_ref=peets_prod_main 时，可以这样配置：
# VOLC_CREDENTIAL_PEETS_PROD_MAIN_AK=
# VOLC_CREDENTIAL_PEETS_PROD_MAIN_SK=
